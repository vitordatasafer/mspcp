# /etc/mspvdc/mspvdc.env — lido pelos serviços mspvdc-api e mspvdc-worker.
# Depois de editar: systemctl restart mspvdc-api mspvdc-worker

DATABASE_URL=postgres://mspvdc:SENHA@127.0.0.1:5432/mspvdc?sslmode=disable

# Login: local (usuário, senha e 2FA no próprio portal) ou oidc (Keycloak).
AUTH_MODE=local
# Nome que aparece no app autenticador e na tela de login.
PRODUCT_NAME=mspclouds

# HTTPS próprio. Troque pelos arquivos do seu certificado quando tiver um
# (ex.: Let's Encrypt). O serviço lê como usuário mspvdc.
LISTEN_ADDR=:443
TLS_CERT_FILE=/etc/mspvdc/tls/server.crt
TLS_KEY_FILE=/etc/mspvdc/tls/server.key
# Porta 80 só redireciona para HTTPS (vazio = desligado).
HTTP_REDIRECT_ADDR=:80

# Chave que cifra os tokens dos clusters guardados no banco. Gerada na
# instalação; sem ela os clusters cadastrados não conectam (faça backup).
MASTER_KEY_FILE=/etc/mspvdc/master.key

# Opcional: restringe os hosts do Proxmox que o portal pode acessar
# (host ou host:porta, separados por vírgula). Vazio = qualquer host
# cadastrado pela administração, menos loopback e link-local.
PROXMOX_ALLOWED_HOSTS=

# Segredos em arquivo (legado, referências file:<nome>).
SECRETS_DIR=/etc/mspvdc/secrets

WEB_DIR=/usr/share/mspvdc/web
SYNC_INTERVAL=20s
WORKER_CONCURRENCY=20
# true só atrás de um proxy reverso (Nginx) que define X-Forwarded-For/Proto.
TRUST_PROXY_HEADERS=false
LOG_LEVEL=info

# Só com AUTH_MODE=oidc:
# OIDC_ISSUER=https://sso.exemplo.com.br/realms/mspclouds
# OIDC_AUDIENCE=mspvdc-portal
# OIDC_CLIENT_ID=mspvdc-portal
# OIDC_CA_FILE=/etc/mspvdc/keycloak-ca.pem
