DATABASE_URL=postgres://mspcp:mspcp@db:5432/mspcp?sslmode=disable

# Login: local (usuário e senha no portal) ou oidc (Keycloak, abaixo).
AUTH_MODE=oidc

# Realm no Keycloak e client do portal (o "aud" do access token).
OIDC_ISSUER=http://keycloak:8080/realms/mspclouds
OIDC_AUDIENCE=mspcp-portal
# Client público do portal (PKCE). Padrão: o mesmo valor de OIDC_AUDIENCE.
OIDC_CLIENT_ID=mspcp-portal
# OIDC_CA_FILE=/etc/mspcp/keycloak-ca.pem

# Hosts das APIs do PVE, separados por vírgula (host ou host:porta).
PROXMOX_ALLOWED_HOSTS=pve-cirion-01.mgmt.mspclouds.local,pve-ascenty-01.mgmt.mspclouds.local

SECRETS_DIR=/run/secrets
SYNC_INTERVAL=20s
WORKER_CONCURRENCY=50
LISTEN_ADDR=:8080
# HTTPS próprio (vazio = HTTP, só atrás de proxy)
# TLS_CERT_FILE=/etc/mspcp/tls/server.crt
# TLS_KEY_FILE=/etc/mspcp/tls/server.key
# Build do portal (web/dist). Vazio = API sem portal.
WEB_DIR=/srv/web
TRUST_PROXY_HEADERS=false
LOG_LEVEL=info
